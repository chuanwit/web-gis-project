# DeepSeek API Key (https://platform.deepseek.com 申请)
# 留空或不配置则走规则引擎降级模式, 不影响答辩演示
DEEPSEEK_API_KEY=

# 模型名 (可选, 默认 deepseek-chat, 也可用 deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek 接口地址 (可选, 默认官方地址)
# DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# Express 服务端口 (可选, 默认 3001)
AI_PORT=3001


